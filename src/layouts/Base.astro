---
import '../styles/global.css';
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import { site, tel } from '../data/site';
import { logo } from '../data/images';
import SocialLinks from '../components/SocialLinks.astro';
import ReviewBadge from '../components/ReviewBadge.astro';

interface Props {
  title: string;
  description: string;
  current?: string;
  /** Page opens with a full-bleed dark hero: the header sits on top of it until the reader scrolls. */
  hero?: boolean;
}

const { title, description, current = '', hero = false } = Astro.props;
const nav = [
  ['/', 'Home'],
  ['/guiding/', 'Guiding'],
  ['/rivers/', 'Rivers'],
  ['/trips/', 'Recent trips'],
  ['/veterans/', 'Veterans'],
  ['/lodging/', 'Lodging'],
  ['/contact/', 'Contact'],
];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Instrument+Sans:wght@400;500;600&display=swap" />
  </head>
  <body class:list={[{ 'has-hero': hero }]}>
    <div class="progress" aria-hidden="true"></div>
    <header class="site-header" id="site-header">
      <div class="wrap bar">
        <a href={url('/')} class="brand">
          <span class="brand-name">Transylvania Fly Fishing</span>
          <span class="brand-sub">Apuseni · Bucovina</span>
        </a>
        <input type="checkbox" id="menu" class="sr-only" />
        <label for="menu" class="menu-toggle">Menu</label>
        <nav class="nav">
          {nav.map(([href, label]) => (
            <a href={url(href)} class:list={['nav-link', { active: href === current }]}>{label}</a>
          ))}
          <a href={url('/book/')} class="btn btn-accent btn-sm">Book your trip</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap"><div class="wave-rule foot-rule"></div></div>
      <div class="wrap foot">
        <div class="foot-col">
          <span class="foot-brand">Transylvania Fly Fishing</span>
          <span>Guided fly fishing in the Apuseni Mountains and Bucovina, Romania. Catch and release only.</span>
        </div>
        <div class="foot-col foot-links">
          {nav.slice(1).map(([href, label]) => <a href={url(href)}>{label}</a>)}
        </div>
        <div class="foot-col">
          <span>{site.company}</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span>{site.phones.map((p, i) => <><a href={tel(p)}>{p}</a>{i < site.phones.length - 1 && ' · '}</>)}</span>
          <SocialLinks limit={3} direction="row" />
        </div>
        <div class="foot-col">
          <span class="foot-label">Partners</span>
          <div class="partners">
            {site.partners.map(([name, href, img]) => <a href={href} rel="noopener" title={name}><Image src={logo(img)} alt={name} height={72} /></a>)}
          </div>
        </div>
      </div>
    </footer>
    <ReviewBadge />
  </body>
</html>

<script>
  // Header: solid once the reader has scrolled past the top of the page.
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Scroll reveal: mark the outermost blocks of each page, then fade them in as they enter the viewport.
  const selector = '.page-head > *, .section-head, .intro > *, .summary, .card, .frame, .prose, .panel, .tint, .trip, .grid-2 > *, .cta-body > *, .layout > *, .foot-col';
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!still && 'IntersectionObserver' in window) {
    const blocks = [...document.querySelectorAll<HTMLElement>(selector)].filter(
      (el) => !el.parentElement?.closest('[data-reveal]') && !el.closest('.hero'),
    );
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          seen.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );
    for (const el of blocks) {
      // Stagger siblings that sit side by side (cards in a grid), up to four steps.
      const siblings = [...(el.parentElement?.children ?? [])].filter((c) => c.matches(selector));
      el.style.setProperty('--i', String(Math.min(Math.max(siblings.indexOf(el), 0), 4)));
      el.setAttribute('data-reveal', '');
      seen.observe(el);
    }
  }
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 30; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0); pointer-events: none; }
  @supports (animation-timeline: scroll()) {
    .progress { animation: progress linear both; animation-timeline: scroll(root); }
    @keyframes progress { to { transform: scaleX(1); } }
  }
  .site-header { position: sticky; top: 0; z-index: 20; background: rgba(245, 242, 236, .88); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); border-bottom: 1px solid var(--line); transition: background-color .4s, border-color .4s, box-shadow .4s; }
  .site-header.scrolled { box-shadow: 0 10px 30px -22px rgba(28, 42, 38, .5); }
  .bar { height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .menu-toggle { flex: 0 0 auto; }
  .brand { display: flex; flex-direction: column; gap: 5px; color: var(--ink); transition: color .4s; }
  .brand:hover { text-decoration: none; }
  .brand-name { font-family: var(--serif); font-size: clamp(21px, 5.6vw, 27px); line-height: 1; font-weight: 600; letter-spacing: .02em; white-space: nowrap; }
  .brand-sub { display: flex; align-items: center; gap: 10px; font-size: clamp(10.5px, 2.9vw, 12.5px); line-height: 1; font-weight: 600; letter-spacing: .26em; text-transform: uppercase; color: var(--accent); white-space: nowrap; transition: color .4s; }
  .brand-sub::after { content: ''; flex: 1; height: 1px; background: currentColor; opacity: .45; }
  .nav { display: flex; gap: clamp(16px, 1.7vw, 26px); align-items: center; }
  .nav-link { position: relative; font-size: 17px; letter-spacing: .01em; white-space: nowrap; color: var(--ink); padding: 6px 0; transition: color .3s; }
  .nav-link::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: 0 50%; transition: transform .35s var(--ease); }
  .nav-link:hover { color: var(--accent); text-decoration: none; }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }
  .menu-toggle { display: none; }

  @media (max-width: 1180px) {
    .menu-toggle { display: inline-flex; align-items: center; border: 1px solid #CFC8BC; border-radius: var(--btn-radius); padding: 10px 16px; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; min-height: 44px; cursor: pointer; }
    .nav { display: none; position: absolute; left: 0; right: 0; top: 76px; flex-direction: column; align-items: stretch; gap: 0; background: var(--bg); border-top: 1px solid var(--line); padding: 12px var(--pad-x) 20px; }
    #menu:checked ~ .nav { display: flex; }
    .nav-link { font-family: var(--serif); font-size: 26px; letter-spacing: .02em; padding: 14px 0; border-bottom: 1px solid var(--line-3); }
    .nav-link.active { color: var(--accent); }
    .nav-link::after { display: none; }
    .nav .btn { margin-top: 16px; }
  }

  /* Pages with a full-bleed hero: the header floats over the photo until the reader scrolls. */
  :global(body.has-hero) .site-header { position: fixed; left: 0; right: 0; }
  :global(body.has-hero) .site-header:not(.scrolled) { background: linear-gradient(180deg, rgba(14, 22, 19, .72), rgba(14, 22, 19, 0)); border-bottom-color: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
  :global(body.has-hero) .site-header:not(.scrolled) .brand,
  :global(body.has-hero) .site-header:not(.scrolled) .menu-toggle { color: var(--on-dark); border-color: rgba(245, 242, 236, .5); }
  :global(body.has-hero) .site-header:not(.scrolled) .brand-sub { color: #A9E6C8; }
  @media (min-width: 1181px) {
    :global(body.has-hero) .site-header:not(.scrolled) .nav-link { color: var(--on-dark); }
    :global(body.has-hero) .site-header:not(.scrolled) .nav-link::after { background: var(--on-dark); }
  }
  /* An open mobile menu always sits on a solid bar. */
  :global(body.has-hero) .site-header:has(#menu:checked) { background: var(--bg); }
  :global(body.has-hero) .site-header:has(#menu:checked) .brand,
  :global(body.has-hero) .site-header:has(#menu:checked) .menu-toggle { color: var(--ink); border-color: #CFC8BC; }
  :global(body.has-hero) .site-header:has(#menu:checked) .brand-sub { color: var(--accent); }

  .site-footer { margin-top: var(--section); background: var(--bg-2); }
  .foot-rule { margin-top: -6px; }
  .foot { padding-top: 40px; padding-bottom: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 28px; font-size: 13px; color: var(--ink-2); line-height: 1.6; }
  .foot-col { display: flex; flex-direction: column; gap: 6px; }
  .foot-brand { font-family: var(--serif); font-size: 24px; font-weight: 600; color: var(--ink); }
  .foot-links a, .foot a { color: var(--ink-2); }
  .foot a:hover { color: var(--accent); }
  .foot-label { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .partners { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .partners img { height: 36px; width: auto; display: block; filter: grayscale(1); opacity: .7; transition: filter .3s, opacity .3s; }
  .partners a:hover img { filter: none; opacity: 1; }
</style>
