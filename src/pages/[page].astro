---
import Base from '../layouts/Base.astro';

export function getStaticPaths() {
  return [
    { params: { page: 'guiding' }, props: { title: 'Guiding' } },
    { params: { page: 'rivers' }, props: { title: 'Rivers' } },
    { params: { page: 'trips' }, props: { title: 'Recent trips' } },
    { params: { page: 'veterans' }, props: { title: 'Veterans program' } },
    { params: { page: 'lodging' }, props: { title: 'Lodging' } },
    { params: { page: 'contact' }, props: { title: 'Contact' } },
    { params: { page: 'book' }, props: { title: 'Book your trip' } },
  ];
}

const { page } = Astro.params;
const { title } = Astro.props;
---
<Base title={`${title} · Transylvania Fly Fishing`} description={`${title} at Transylvania Fly Fishing.`} current={`/${page}/`}>
  <section class="wrap stub">
    <div class="eyebrow">Coming next</div>
    <h1>{title}</h1>
    <p class="lead">This page is being built. Until then, write to <a href="mailto:office@transylvaniaflyfishing.com">office@transylvaniaflyfishing.com</a> or call <a href="tel:+40724580508">+40 724 580 508</a>.</p>
    <a href="/" class="link">← Back home</a>
  </section>
</Base>

<style>
  .stub { padding-top: clamp(48px, 7vw, 96px); min-height: 50vh; display: flex; flex-direction: column; gap: 16px; }
  .stub h1 { font-size: clamp(40px, 5.5vw, 72px); line-height: 1; letter-spacing: -.015em; }
  .stub .lead { max-width: 50ch; }
</style>
