---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import RegionMap from '../components/RegionMap.astro';
import { url } from '../lib/url';
import { site } from '../data/site';

const apuseni = [
  {
    name: 'Someșul Cald',
    tag: 'Catch and release',
    photo: 'river4',
    text: 'Springs high in the Apuseni Mountains, carves a gorge through the karst of the Western Carpathians, and after about 27 km reaches the Beliș-Fântânele dam lake. Depending on the lake level, 11 to 15 km of fishable river. About two hours from Cluj-Napoca airport.',
    species: 'Wild brown trout, grayling',
  },
  {
    name: 'Doda Pilii headwaters',
    tag: 'Small water',
    photo: 'doda-pilii-water',
    text: 'The upper river and its side streams around Doda Pilii, inside the Apuseni Nature Park. Small, clear, technical water for short casts and careful wading.',
    species: 'Wild brown trout',
  },
  {
    name: 'Someșul Rece',
    tag: 'Freestone',
    photo: 'river3',
    text: 'The sister river of the Someșul Cald, running through forest and gorge to meet it below the lake. A different character on the same trip.',
    species: 'Wild brown trout, grayling',
  },
  {
    name: 'The Criș rivers',
    tag: 'Western Apuseni',
    photo: 'river1',
    text: 'The Criș valleys drain the western side of the Apuseni. Sebi guides on the upper reaches when conditions suit.',
    species: 'Brown trout, grayling',
  },
  {
    name: 'Beliș-Fântânele lake',
    tag: 'Stillwater',
    photo: 'landscape2',
    text: 'Over 17 km long and more than 105 m deep, the dam lake that swallows the Someșul Cald. A hiding place for lake trout.',
    species: 'Lake trout',
  },
];

const bucovina = [
  { name: 'Bistrița Aurie', tag: 'Bucovina', photo: 'catch14', text: 'The golden Bistrița, in the north of the country, for longer trips out of Câmpulung Moldovenesc.', species: 'Brown trout, grayling' },
  { name: 'Moldova', tag: 'Moldova valley', photo: 'catch18', text: 'The Moldova river and its tributaries, wide gravel water under the Bucovina hills.', species: 'Brown trout, grayling' },
];
---
<Base title="Rivers · Transylvania Fly Fishing" description="The rivers Transylvania Fly Fishing guides on: Someșul Cald, Someșul Rece, the Criș rivers and the Beliș lake in the Apuseni Mountains, and the Bistrița Aurie and Moldova in Bucovina." current="/rivers/">
  <section class="wrap page-head">
    <div class="stack">
      <div class="eyebrow">Rivers</div>
      <h1>Apuseni in the west, Bucovina in the north.</h1>
    </div>
    <p class="lead">Every water Sebi guides, from the karst gorges of the Apuseni to the valleys of Bucovina. Wild brown trout and grayling. Catch and release, barbless, licences arranged by the guide. Season {site.season}.</p>
  </section>

  <div class="wrap">
    <nav class="jump" aria-label="Regions">
      <a href="#apuseni"><span>01</span>Apuseni</a>
      <a href="#bucovina"><span>02</span>Bucovina</a>
    </nav>
  </div>

  <section id="apuseni" class="region">
    <div class="wrap region-body">
      <div class="grid-2 region-head">
        <div class="prose">
          <div class="region-no" aria-hidden="true">01</div>
          <h2>Apuseni</h2>
          <p>The rivers of the Apuseni carve their way through the spectacular karst landscapes of the Western Carpathians. Massive limestone, deep gorges, caves and a mountain lake complete this destination. The surroundings are breathtaking, for fly fishers, for active nature lovers, or for simply relaxing under endless skies.</p>
          <div class="facts">
            <span>Waters</span><span>{apuseni.map((r) => r.name).join(', ')}</span>
            <span>Getting there</span><span>About two hours from Cluj-Napoca airport</span>
          </div>
        </div>
        <RegionMap region="apuseni" />
      </div>
      <div class="frame ratio-219"><Photo class="photo" sizes="100vw" src="river4" alt="Apuseni river gorge" /></div>
      <div class="grid-3">
        {apuseni.map((r) => (
          <article class="card">
            <div class="frame ratio-32"><Photo class="photo" src={r.photo} alt={r.name} /></div>
            <div class="card-body">
              <div class="row"><h3>{r.name}</h3><span class="tag">{r.tag}</span></div>
              <p>{r.text}</p>
              <div class="facts"><span>Species</span><span>{r.species}</span></div>
            </div>
          </article>
        ))}
      </div>
      <div class="prose">
        <h2>Why travel to Transylvania?</h2>
        <p>Transylvania is a cultural centre for foreigners and locals alike, the country's largest and best known region, and where most of Romania's tourism lives. The medieval towns and architecture scattered through it are some of the oldest and best preserved in the country.</p>
      </div>
      <div class="grid-3">
        <article class="card">
          <div class="frame ratio-32"><Photo class="photo" src="landscape2" alt="" /></div>
          <div class="card-body">
            <div class="eyebrow">Spectacular nature</div>
            <h3>Apuseni Nature Park</h3>
            <p>A real paradise of mountain ridges, mysterious caves and underground rivers, deep valleys and gorges. Caving, hiking, mountain biking, climbing, wildlife and bird watching. The Someșul Cald crosses the park from west to east.</p>
          </div>
        </article>
        <article class="card">
          <div class="frame ratio-32"><Photo class="photo" src="cluj" alt="" /></div>
          <div class="card-body">
            <div class="eyebrow">Well preserved history</div>
            <h3>Cluj-Napoca</h3>
            <p>The unofficial capital of Transylvania. No vampires, but castles, fortresses, botanical gardens, museums and parks, local specialties and international cuisine, and a vibrant arts scene from traditional to progressive.</p>
          </div>
        </article>
        <article class="card">
          <div class="frame ratio-32"><Photo class="photo" src="salina_turda" alt="" /></div>
          <div class="card-body">
            <div class="eyebrow">Unbelievable places</div>
            <h3>Turda Salt Mine</h3>
            <p>Ranked first among the coolest underground places in the world by Business Insider. Excavated by hand since the 13th century, now an underground museum and recreation centre with an amphitheatre, sports areas and a lake.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="bucovina" class="region region-dark contours">
    <div class="wrap region-body">
      <div class="grid-2 region-head">
        <div class="prose">
          <div class="region-no" aria-hidden="true">02</div>
          <h2>Bucovina and the Moldova valley</h2>
          <p>For longer trips Sebi takes guests to the north of the country, where his own story with fishing began.</p>
          <div class="facts">
            <span>Waters</span><span>{bucovina.map((r) => r.name).join(', ')}</span>
            <span>Getting there</span><span>Longer trips out of Câmpulung Moldovenesc</span>
          </div>
        </div>
        <RegionMap region="bucovina" />
      </div>
      <div class="grid-3">
        {bucovina.map((r) => (
          <article class="card">
            <div class="frame ratio-32"><Photo class="photo" src={r.photo} alt={r.name} /></div>
            <div class="card-body">
              <div class="row"><h3>{r.name}</h3><span class="tag">{r.tag}</span></div>
              <p>{r.text}</p>
              <div class="facts"><span>Species</span><span>{r.species}</span></div>
            </div>
          </article>
        ))}
      </div>
      <div class="prose">
        <h2>Why travel to Bucovina?</h2>
        <p>Bucovina is the wooded north of Romania, a land of painted monasteries, wooden villages and long mountain valleys. Life here still follows the seasons, the welcome is generous, and the rivers run clear through spruce forest.</p>
      </div>
      <div class="grid-3">
        <article class="card">
          <div class="frame ratio-32"><Photo class="photo" src="bucovina-rarau" alt="The Pietrele Doamnei rock towers above spruce forest on Rarău" /></div>
          <div class="card-body">
            <div class="eyebrow">Spectacular nature</div>
            <h3>Rarău and Giumalău</h3>
            <p>The two massifs that rise above Câmpulung Moldovenesc, with the limestone towers of Pietrele Doamnei, the Lady's Rocks, on the skyline. Spruce forest, alpine meadows and marked trails for hiking, mountain biking and wildlife watching, a short drive from the Moldova river.</p>
          </div>
        </article>
        <article class="card">
          <div class="frame ratio-32"><Photo class="photo" src="bucovina-voronet" alt="Voroneț Monastery with its painted outer walls" /></div>
          <div class="card-body">
            <div class="eyebrow">Well preserved history</div>
            <h3>The painted monasteries</h3>
            <p>Voroneț, Humor, Moldovița and Sucevița, their outer walls covered in frescoes painted in the 15th and 16th centuries. They are UNESCO World Heritage sites, and Voroneț, famous for its blue, stands just outside Gura Humorului.</p>
          </div>
        </article>
        <article class="card">
          <div class="frame ratio-32"><Photo class="photo" src="bucovina-ciocanesti" alt="A house in Ciocănești painted with traditional motifs" /></div>
          <div class="card-body">
            <div class="eyebrow">Unbelievable places</div>
            <h3>Ciocănești</h3>
            <p>A village on the Bistrița Aurie where the houses are painted with the same traditional motifs as the region's decorated Easter eggs. It has a museum of painted eggs, and the river runs right past it.</p>
          </div>
        </article>
      </div>
      <p class="credit">Photos: <a href="https://commons.wikimedia.org/wiki/File:Pietrele_Doamnei_and_Piatra_%C8%98oimului_rocks.jpg" rel="noopener">Constantin I. Barbu</a>, <a href="https://commons.wikimedia.org/wiki/File:M%C4%83n%C4%83stirea_Vorone%C8%9B_vedere_laterala_08.jpg" rel="noopener">Mihai Raducanu</a>, <a href="https://commons.wikimedia.org/wiki/File:Cioc%C4%83ne%C8%99ti,_Suceava.05.jpg" rel="noopener">Nenea hartia</a>, via Wikimedia Commons, <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener license">CC BY-SA 4.0</a>, cropped.</p>
    </div>
  </section>

  <div class="wrap page-body">
    <div class="tint prose">
      <p>Want to fish two regions in one trip? Say so in the request and Sebi will plan the route. <a href={url('/book/')}>Book your trip</a></p>
    </div>
  </div>
</Base>

<style>
  .stack { display: flex; flex-direction: column; gap: 16px; }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .tag { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }

  /* Jump links: one per region. */
  .jump { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 28px; }
  .jump a { display: inline-flex; align-items: baseline; gap: 10px; min-height: 44px; padding: 10px 20px; border: 1px solid var(--line); border-radius: var(--btn-radius); background: var(--surface); color: var(--ink); font-family: var(--serif); font-size: 20px; transition: border-color .25s, transform .25s var(--ease), box-shadow .25s; }
  .jump a:hover { text-decoration: none; border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow); }
  .jump span { font-family: var(--sans); font-size: 11px; letter-spacing: .12em; color: var(--accent); }

  /* Each region is its own block: its own map, facts and rivers, with nothing shared between the two. */
  .region { scroll-margin-top: 76px; padding: clamp(48px, 7vw, 96px) 0; }
  .region-body { display: flex; flex-direction: column; gap: clamp(32px, 4.5vw, 64px); }
  .region-head { align-items: center; }
  .region-no { font-family: var(--serif); font-style: italic; font-size: clamp(48px, 6vw, 84px); line-height: .8; color: var(--accent); opacity: .5; }
  .region-head h2 { font-size: clamp(38px, 5vw, 64px); margin-top: 0; }
  .region-head .facts { margin-top: 8px; max-width: 52ch; }

  .region-dark { background-color: var(--dark); color: var(--on-dark); }
  .region-dark .prose { color: var(--on-dark-2); }
  .region-dark .prose h2 { color: var(--on-dark); }
  .region-dark .region-no { color: var(--accent-on-dark); opacity: .7; }
  .region-dark .region-head .facts { border-top-color: rgba(245, 242, 236, .16); color: var(--on-dark); }
  .region-dark .region-head .facts span:nth-child(odd) { color: var(--on-dark-2); }
  .region-dark :global(.region-map) { background-color: var(--dark-2); box-shadow: inset 0 0 0 1px rgba(245, 242, 236, .08); }
  .region-dark .card { border-color: transparent; color: var(--ink); }
  .credit { margin-top: calc(-1 * clamp(16px, 3vw, 40px)); font-size: 12px; line-height: 1.5; color: var(--muted); }
  .region-dark .credit { color: var(--on-dark-2); }
  .region-dark .credit a { color: var(--on-dark); text-decoration: underline; text-underline-offset: 3px; }
  .region-dark + .page-body { padding-top: clamp(40px, 5vw, 72px); }
</style>
