---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const whatsapp = `https://wa.me/${site.whatsapp.replace('+', '')}`;
---
<Base title="Book your trip · Transylvania Fly Fishing" description="Send a booking request with your dates, group size and trip type. Sebi replies personally with availability, a plan and the price." current="/book/">
  <div class="wrap layout">
    <div class="stack">
      <div class="eyebrow">Book your trip</div>
      <h1>Pick your dates. Sebi confirms.</h1>
      <p class="lead">This is a request, not a charge. Sebi replies personally within two days with a plan, availability and the price. Nothing is paid until you both agree.</p>
      <div class="tint season">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
        <div><strong>Season {site.season}</strong><br /><span>Packages are minimum two days and two anglers.</span></div>
      </div>
      <ol class="steps">
        <li><strong>You send the request.</strong> Dates, anglers, what kind of trip. Two minutes.</li>
        <li><strong>Sebi replies with the plan.</strong> River, lodging, price, pickup.</li>
        <li><strong>You confirm.</strong> The dates are yours.</li>
      </ol>
      <div class="facts">
        <span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a>
        <span>WhatsApp</span><a href={whatsapp} rel="noopener">{site.phones[0]}</a>
        <span>Getting here</span><span>Fly to Cluj-Napoca (CLJ). The Apuseni rivers are about 2 h by car, pickup on request. Bucovina is a longer journey; Sebi plans the route with you.</span>
      </div>
    </div>

    <form class="panel form" id="booking" data-to={site.email} data-whatsapp={whatsapp}>
      <div class="form-row">
        <label class="field">First day<input type="date" name="from" required /></label>
        <label class="field">Last day<input type="date" name="to" required /></label>
      </div>
      <p class="error" id="date-error" role="alert" hidden></p>
      <p class="notice" id="season-note" role="status" hidden>These dates are outside the fishing season ({site.season}). You can still send the request, and Sebi will tell you what is possible.</p>
      <label class="field">Trip type
        <select name="type">
          <option>All-inclusive stay (lodging, meals, licences, guiding)</option>
          <option>Guided days only (I arrange my own lodging)</option>
          <option>Fishing and sightseeing (river days and local sights)</option>
          <option>Veterans program</option>
          <option>Course or something else (casting, tying, kids, custom)</option>
        </select>
      </label>
      <div class="form-row">
        <label class="field">Anglers<select name="anglers"><option>2</option><option>1</option><option>3</option><option>4 or more</option></select></label>
        <label class="field">Region<select name="region"><option>Apuseni Mountains</option><option>Bucovina</option><option>Let Sebi choose</option></select></label>
      </div>
      <div class="form-row">
        <label class="field">Name<input type="text" name="name" required /></label>
        <label class="field">Email<input type="email" name="email" required /></label>
      </div>
      <label class="field">Anything else<textarea name="message" rows="4" placeholder="Experience, equipment you need, airport pickup, non-fishing companions"></textarea></label>
      <button type="submit" class="btn btn-accent">Send booking request</button>
      <p class="fine">Opens your email app with the request filled in, addressed to {site.email}. No payment is taken on this site.</p>

      <div class="sent tint" id="sent" tabindex="-1" hidden>
        <strong>Your request is ready to send.</strong>
        <p>If your email app did not open, send it one of these ways instead:</p>
        <div class="sent-actions">
          <a class="btn btn-accent btn-sm" id="send-whatsapp" rel="noopener" target="_blank">Send on WhatsApp</a>
          <a class="btn btn-sm btn-outline" id="send-email">Open email app again</a>
          <button type="button" class="btn btn-sm btn-outline" id="copy">Copy the message</button>
        </div>
        <p class="fine">Or copy it and email it to <a href={`mailto:${site.email}`}>{site.email}</a> from your webmail.</p>
        <textarea id="summary" rows="9" readonly aria-label="Your booking request"></textarea>
      </div>
    </form>
  </div>
</Base>

<script>
  const form = document.getElementById('booking') as HTMLFormElement;
  const from = form.elements.namedItem('from') as HTMLInputElement;
  const to = form.elements.namedItem('to') as HTMLInputElement;
  const dateError = document.getElementById('date-error') as HTMLElement;
  const seasonNote = document.getElementById('season-note') as HTMLElement;
  const sent = document.getElementById('sent') as HTMLElement;
  const summary = document.getElementById('summary') as HTMLTextAreaElement;
  const emailLink = document.getElementById('send-email') as HTMLAnchorElement;
  const whatsappLink = document.getElementById('send-whatsapp') as HTMLAnchorElement;
  const copy = document.getElementById('copy') as HTMLButtonElement;

  // Dates: nothing in the past, and the last day cannot be before the first.
  const pad = (n: number) => String(n).padStart(2, '0');
  const now = new Date();
  from.min = to.min = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  from.addEventListener('change', () => {
    if (from.value) to.min = from.value;
    checkDates();
  });
  to.addEventListener('change', checkDates);

  // Date inputs give yyyy-mm-dd; read the parts directly so time zones cannot shift the day.
  const parts = (iso: string) => iso.split('-').map(Number);
  const longDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
  const pretty = (iso: string) => {
    const [y, m, d] = parts(iso);
    return longDate.format(new Date(y, m - 1, d));
  };

  // Season is 1 April to 30 September. Outside it we warn but still let the request through.
  const inSeason = (iso: string) => {
    const month = parts(iso)[1];
    return month >= 4 && month <= 9;
  };
  function outOfSeason() {
    if (from.value && !inSeason(from.value)) return true;
    if (to.value && !inSeason(to.value)) return true;
    // Both ends in season but in different years: the stay runs through a winter.
    return Boolean(from.value && to.value && parts(from.value)[0] !== parts(to.value)[0]);
  }

  function checkDates() {
    const bad = Boolean(from.value && to.value && to.value < from.value);
    dateError.textContent = bad ? 'The last day is before the first day.' : '';
    dateError.hidden = !bad;
    seasonNote.hidden = bad || !outOfSeason();
    return !bad;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!checkDates()) {
      to.focus();
      return;
    }
    const d = new FormData(form);
    const dates = `${pretty(from.value)} to ${pretty(to.value)}`;
    const subject = `Booking request: ${d.get('anglers')} anglers, ${dates}`;
    const body = [
      `Dates: ${dates}${outOfSeason() ? ' (outside the season)' : ''}`,
      `Trip type: ${d.get('type')}`,
      `Anglers: ${d.get('anglers')}`,
      `Region: ${d.get('region')}`,
      `Name: ${d.get('name')}`,
      `Email: ${d.get('email')}`,
      '',
      String(d.get('message') ?? ''),
    ].join('\n').trim();

    const mailto = `mailto:${form.dataset.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    emailLink.href = mailto;
    whatsappLink.href = `${form.dataset.whatsapp}?text=${encodeURIComponent(`${subject}\n\n${body}`)}`;
    summary.value = `${subject}\n\n${body}`;
    copy.textContent = 'Copy the message';

    // A browser cannot tell whether a mail app opened, so always show the other ways to send.
    sent.hidden = false;
    sent.focus();
    sent.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    location.href = mailto;
  });

  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(summary.value);
    } catch {
      summary.select();
      document.execCommand('copy');
    }
    copy.textContent = 'Copied';
  });
</script>

<style>
  .layout { padding-top: clamp(48px, 7vw, 96px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .stack { display: flex; flex-direction: column; gap: 20px; }
  .stack h1 { font-size: clamp(40px, 5.5vw, 72px); line-height: 1; letter-spacing: -.015em; }
  .stack .lead { max-width: 44ch; }
  .season { display: flex; align-items: center; gap: 16px; color: var(--accent); font-size: 14px; }
  .season div { color: var(--ink); }
  .season span { color: var(--ink-2); font-size: 13px; }
  .steps { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 12px; font-size: 15px; line-height: 1.6; color: var(--ink-2); }
  .steps strong { color: var(--ink); font-weight: 500; }
  .form { display: flex; flex-direction: column; gap: 16px; }
  .form .btn { align-self: flex-start; }
  .fine { font-size: 12px; line-height: 1.5; color: var(--muted); }
  .error { margin: -6px 0 0; font-size: 13px; color: #A3341F; }
  .notice { margin: -6px 0 0; padding: 10px 14px; border-radius: 4px; background: #FBF1DC; color: #6B4A0E; font-size: 13px; line-height: 1.5; }
  .sent { display: flex; flex-direction: column; gap: 12px; font-size: 14px; line-height: 1.5; }
  .sent[hidden] { display: none; }
  .sent:focus { outline: none; }
  .sent p { margin: 0; }
  .sent-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .sent .btn { align-self: auto; }
  .btn-outline { background: transparent; border: 1px solid var(--accent); color: var(--accent); cursor: pointer; }
  .btn-outline:hover { background: var(--accent); color: #fff; }
  .sent textarea { width: 100%; padding: 12px 14px; border: 1px solid #D6CFC4; border-radius: 4px; background: #FBFAF7; font: 13px/1.5 ui-monospace, Menlo, monospace; resize: vertical; }
</style>
