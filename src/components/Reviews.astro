---
import { google } from '../data/reviews';
import Stars from './Stars.astro';
---
<section class="wrap section reviews" id="reviews">
  <div class="summary">
    <div class="eyebrow">Reviews</div>
    <h2 class="score"><span>{google.rating.toFixed(1)}</span> on Google</h2>
    <div class="meta"><Stars rating={google.rating} size={22} /><span>{google.count} reviews</span></div>
    <a href={google.url} class="link" rel="noopener" target="_blank">Read the reviews on Google →</a>
  </div>
  <div class="quotes">
    {google.reviews.map((r) => (
      <figure class="card quote">
        <Stars rating={5} />
        <blockquote>{r.text}</blockquote>
        <figcaption><strong>{r.name}</strong><span>{r.when} · Google</span></figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .reviews { display: grid; grid-template-columns: minmax(220px, 1fr) minmax(0, 2.4fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .summary { display: flex; flex-direction: column; gap: 14px; position: sticky; top: 108px; }
  .score { font-size: clamp(36px, 4.5vw, 60px); line-height: 1; letter-spacing: -.01em; }
  .score span { font-size: 1.5em; color: var(--accent); }
  .meta { display: flex; align-items: center; gap: 12px; font-size: 15px; color: var(--ink-2); }
  .quotes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 20px; }
  .quote { margin: 0; padding: clamp(22px, 3vw, 34px); gap: 16px; }
  blockquote { margin: 0; flex: 1; font-family: var(--serif); font-size: clamp(19px, 1.7vw, 22px); line-height: 1.4; color: var(--ink); }
  figcaption { display: flex; flex-direction: column; gap: 2px; padding-top: 14px; border-top: 1px solid var(--line-3); font-size: 13px; color: var(--muted); }
  figcaption strong { font-size: 15px; font-weight: 600; color: var(--ink); }
  @media (max-width: 860px) {
    .reviews { grid-template-columns: 1fr; }
    .summary { position: static; }
  }
</style>
