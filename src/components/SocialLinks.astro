---
import { siFacebook, siInstagram, siYoutube, siX } from 'simple-icons';
import { site } from '../data/site';

interface Props {
  limit?: number;
  direction?: 'row' | 'column';
}

const { limit, direction = 'column' } = Astro.props;
const icons: Record<string, string> = { facebook: siFacebook.path, instagram: siInstagram.path, youtube: siYoutube.path, x: siX.path };
const links = limit ? site.social.slice(0, limit) : site.social;
---
<ul class:list={['social', direction]}>
  {links.map((s) => (
    <li>
      <a href={s.href} rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={icons[s.icon]}></path></svg>
        <span>{s.label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .social { list-style: none; margin: 0; padding: 0; display: flex; gap: 10px 18px; }
  .column { flex-direction: column; }
  .row { flex-wrap: wrap; }
  a { display: inline-flex; align-items: center; gap: 10px; min-height: 28px; }
  svg { flex: 0 0 auto; }
</style>
