---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photo } from '../data/images';

interface Props {
  /** File name in src/assets/photos without the extension, or an imported image. */
  src: string | ImageMetadata;
  alt?: string;
  sizes?: string;
  /** Above-the-fold image: load immediately with high priority. */
  eager?: boolean;
  class?: string;
  [attr: string]: unknown;
}

const { src, alt = '', sizes = '(min-width: 800px) 50vw, 100vw', eager = false, ...rest } = Astro.props;
const image = typeof src === 'string' ? photo(src) : src;
---
<Image
  src={image}
  alt={alt}
  widths={[480, 800, 1200, 1920]}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  {...rest}
/>
